# Generated by scripts/generate.py. This directory is a standalone build context.
FROM ubuntu:18.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETARCH
RUN test "$(dpkg --print-architecture)" = "amd64" && \
    test -z "$TARGETARCH" -o "$TARGETARCH" = "amd64"
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=Etc/UTC
RUN printf 'Acquire::Retries "3";\n' > /etc/apt/apt.conf.d/80-retries && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential gcc g++ gdb vim openssh-server python3 python3-pip python3-dev \
      sudo gosu ca-certificates curl wget gnupg dirmngr locales tzdata \
      git cmake pkg-config bash-completion iproute2 procps xauth \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
# Tini is not packaged for Bionic; pin the upstream static binary and SHA-256.
RUN curl -fL --retry 3 https://github.com/krallin/tini/releases/download/v0.19.0/tini-static-amd64 -o /usr/bin/tini && \
    echo 'c5b0666b4cb676901f90dfcb37106783c5fe2077b04590973b885950611b30ee  /usr/bin/tini' | sha256sum -c - && chmod 755 /usr/bin/tini
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python python-dev python-pip && rm -rf /var/lib/apt/lists/*
# Write one complete configuration; old OpenSSH does not support sshd_config.d.
RUN printf '%s\n' \
      'Port 22' 'HostKey /etc/ssh/ssh_host_rsa_key' 'HostKey /etc/ssh/ssh_host_ecdsa_key' \
      'HostKey /etc/ssh/ssh_host_ed25519_key' 'PermitRootLogin no' 'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' 'PermitEmptyPasswords no' 'UsePAM yes' \
      'X11Forwarding yes' 'PrintMotd no' 'AcceptEnv LANG LC_*' \
      'Subsystem sftp /usr/lib/openssh/sftp-server' > /etc/ssh/sshd_config && \
    mkdir -p /workspace && chmod 1777 /workspace
# Same final snapshot and signing key as the official ROS Docker images.
RUN curl -fsSL --retry 3 'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA' -o /tmp/ros.asc && \
    gpg --show-keys --with-colons /tmp/ros.asc | grep -q 'fpr:::::::::4B63CF8FDE49746E98FA01DDAD19BAB3CBF125EA:' && \
    gpg --dearmor < /tmp/ros.asc > /usr/share/keyrings/ros1-snapshots.gpg && rm /tmp/ros.asc && \
    echo 'deb [signed-by=/usr/share/keyrings/ros1-snapshots.gpg] http://snapshots.ros.org/melodic/final/ubuntu bionic main' > /etc/apt/sources.list.d/ros1.list
ENV ROS_DISTRO=melodic ROS_VERSION=1 ROS_PYTHON_VERSION=2
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ros-melodic-ros-base python-rosdep python-rosinstall python-vcstools python-catkin-tools && \
    rosdep init && rm -rf /var/lib/apt/lists/* && \
    printf '%s\n' 'source /opt/ros/melodic/setup.bash' > /etc/profile.d/ros.sh && \
    echo 'source /etc/profile.d/ros.sh' >> /etc/bash.bashrc
ENV USER=ubuntu IMAGE_DESKTOP=0
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && rm -f /etc/ssh/ssh_host_* /etc/machine-id /var/lib/dbus/machine-id
EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["services"]
