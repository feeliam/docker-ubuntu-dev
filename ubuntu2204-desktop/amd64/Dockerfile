# Generated by scripts/generate.py. This directory is a standalone build context.
FROM ubuntu:22.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETARCH
RUN test "$(dpkg --print-architecture)" = "amd64" && \
    test -z "$TARGETARCH" -o "$TARGETARCH" = "amd64"
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=Etc/UTC
RUN printf 'Acquire::Retries "3";\n' > /etc/apt/apt.conf.d/80-retries && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential gcc g++ gdb vim openssh-server python3 python3-pip python3-dev \
      sudo gosu tini ca-certificates curl wget gnupg dirmngr locales tzdata \
      git cmake pkg-config bash-completion iproute2 procps xauth \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python-is-python3 && rm -rf /var/lib/apt/lists/*
# Write one complete configuration; old OpenSSH does not support sshd_config.d.
RUN printf '%s\n' \
      'Port 22' 'HostKey /etc/ssh/ssh_host_rsa_key' 'HostKey /etc/ssh/ssh_host_ecdsa_key' \
      'HostKey /etc/ssh/ssh_host_ed25519_key' 'PermitRootLogin no' 'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' 'PermitEmptyPasswords no' 'UsePAM yes' \
      'X11Forwarding yes' 'PrintMotd no' 'AcceptEnv LANG LC_*' \
      'Subsystem sftp /usr/lib/openssh/sftp-server' > /etc/ssh/sshd_config && \
    mkdir -p /workspace && chmod 1777 /workspace
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      mate-desktop-environment-core mate-terminal dbus-x11 dbus policykit-1 \
      tigervnc-standalone-server tigervnc-common novnc websockify supervisor \
      fonts-dejavu fonts-noto-cjk x11-utils x11-xserver-utils \
    && rm -rf /var/lib/apt/lists/* /etc/machine-id /var/lib/dbus/machine-id && \
    ln -sf vnc.html /usr/share/novnc/index.html
# Native Firefox DEB; avoid Ubuntu's Snap transition package in containers.
RUN curl -fsSL --retry 3 https://packages.mozilla.org/apt/repo-signing-key.gpg -o /tmp/mozilla.asc && \
    gpg --show-keys --with-colons /tmp/mozilla.asc | grep -q 'fpr:::::::::35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3:' && \
    gpg --dearmor < /tmp/mozilla.asc > /usr/share/keyrings/mozilla.gpg && rm /tmp/mozilla.asc && \
    echo 'deb [signed-by=/usr/share/keyrings/mozilla.gpg] https://packages.mozilla.org/apt mozilla main' > /etc/apt/sources.list.d/mozilla.list && \
    printf 'Package: *\nPin: origin packages.mozilla.org\nPin-Priority: 1001\n' > /etc/apt/preferences.d/mozilla && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends firefox && \
    rm -rf /var/lib/apt/lists/*
ENV USER=ubuntu IMAGE_DESKTOP=1
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && rm -f /etc/ssh/ssh_host_* /etc/machine-id /var/lib/dbus/machine-id
EXPOSE 22 80
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["services"]
