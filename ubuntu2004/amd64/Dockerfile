# Generated by scripts/generate.py. This directory is a standalone build context.
FROM ubuntu:20.04
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG TARGETARCH
RUN test "$(dpkg --print-architecture)" = "amd64" && \
    test -z "$TARGETARCH" -o "$TARGETARCH" = "amd64"
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=Etc/UTC
RUN printf 'Acquire::Retries "3";\n' > /etc/apt/apt.conf.d/80-retries && \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential gcc g++ gdb vim openssh-server python3 python3-pip python3-dev \
      sudo gosu tini ca-certificates curl wget gnupg dirmngr locales tzdata \
      git cmake pkg-config bash-completion iproute2 procps xauth \
    && rm -rf /var/lib/apt/lists/* /etc/ssh/ssh_host_*
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python-is-python3 && rm -rf /var/lib/apt/lists/*
# Write one complete configuration; old OpenSSH does not support sshd_config.d.
RUN printf '%s\n' \
      'Port 22' 'HostKey /etc/ssh/ssh_host_rsa_key' 'HostKey /etc/ssh/ssh_host_ecdsa_key' \
      'HostKey /etc/ssh/ssh_host_ed25519_key' 'PermitRootLogin no' 'PasswordAuthentication yes' \
      'PubkeyAuthentication yes' 'PermitEmptyPasswords no' 'UsePAM yes' \
      'X11Forwarding yes' 'PrintMotd no' 'AcceptEnv LANG LC_*' \
      'Subsystem sftp /usr/lib/openssh/sftp-server' > /etc/ssh/sshd_config && \
    mkdir -p /workspace && chmod 1777 /workspace
ENV USER=ubuntu IMAGE_DESKTOP=0
COPY entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && rm -f /etc/ssh/ssh_host_* /etc/machine-id /var/lib/dbus/machine-id
EXPOSE 22
ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
CMD ["services"]
